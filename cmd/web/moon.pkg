import {
  "guolei-dev/tcl" @lib,
  "moonbitlang/core/json",
}

supported_targets = "js"

pkgtype(kind: "executable")

options(
  link: {
    "js": {
      "exports": [
        "run",
        "evaluate",
        "new_session",
        "session_eval",
        "reset_session",
        "close_session",
        "session_io",
      ],
      "format": "esm",
    },
  },
)
