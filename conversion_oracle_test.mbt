// Original programs, expected results evaluated by Tcl 8.6.15. Do not hand-edit.

///|
test "Tcl conversion format-0" {
  let t = @tcl.Interpreter::new()
  assert_eq(t.eval("format \"%d\" \"0\"", budget=100000), "0")
  assert_eq(t.output_text(), "")
}

///|
test "Tcl conversion format-1" {
  let t = @tcl.Interpreter::new()
  assert_eq(t.eval("format \"%d\" \"1\"", budget=100000), "1")
  assert_eq(t.output_text(), "")
}

