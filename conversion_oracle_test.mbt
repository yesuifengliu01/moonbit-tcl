  let t = @tcl.Interpreter::new()
  assert_eq(
    t.eval(
      "set a OLD;set b OLD;set r [scan \"0xg\" \"%f%n\" a b];list $r $a $b",
      budget=100000,
    ),
    "2 0.0 1",
  )
  assert_eq(t.output_text(), "")
}

