///|
test "Tcl conversion conversion-state-4963" {
  let t = @tcl.Interpreter::new()
  assert_eq(t.eval("scan {12 34} {%2$d %1$d} a a;set a", budget=100000), "12")
  assert_eq(t.output_text(), "")
}

///|
test "Tcl conversion conversion-state-4964" {
  let t = @tcl.Interpreter::new()
  assert_eq(t.eval("scan {NaN 7} {%*f%d%n}", budget=100000), "7 5")
  assert_eq(t.output_text(), "")
}

///|
test "Tcl conversion conversion-state-4965" {
  let t = @tcl.Interpreter::new()
  assert_eq(t.eval("scan {NaN(abc) 7} {%*f%d%n}", budget=100000), "7 10")
  assert_eq(t.output_text(), "")
}

///|
test "Tcl conversion conversion-state-4966" {
  let t = @tcl.Interpreter::new()
  assert_eq(t.eval("scan {NaN(z) 7} {%*f%s%n}", budget=100000), "(z) 6")
  assert_eq(t.output_text(), "")
}

///|
test "Tcl conversion conversion-state-4967" {
  let t = @tcl.Interpreter::new()
  assert_eq(t.eval("scan {NaN} {%*f%d}", budget=100000), "{}")
  assert_eq(t.output_text(), "")
}

///|
test "Tcl conversion conversion-state-4968" {
  let t = @tcl.Interpreter::new()
  assert_eq(t.eval("scan {NaN} {%f%n}", budget=100000), "{} {}")
  assert_eq(t.output_text(), "")
}

///|
test "Known difference local contract conversion conversion-state-4969" {
  let t = @tcl.Interpreter::new()
  assert_eq(
    t.eval(
      "scan 18446744073709551616 %f v;list [format %.17g $v] [set v]",
      budget=100000,
    ),
    "1.844674407370955e+19 1.844674407370955e+19",
  )
  assert_eq(t.output_text(), "")
}
