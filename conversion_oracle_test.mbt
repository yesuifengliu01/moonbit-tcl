///|
test "Tcl conversion conversion-state-4852" {
  let t = @tcl.Interpreter::new()
  assert_eq(
    t.eval(
      "set a old;set b old;scan {12 x} {%d%d} a b;list $a $b",
      budget=100000,
    ),
    "12 old",
  )
  assert_eq(t.output_text(), "")
}

///|
test "Tcl conversion conversion-state-4853" {
  let t = @tcl.Interpreter::new()
  assert_eq(
    t.eval(
      "set a old;set b old;catch {scan {12 34} {%d%q} a b};list $a $b",
      budget=100000,
    ),
    "old old",
  )
  assert_eq(t.output_text(), "")
}

///|
test "Tcl conversion conversion-state-4854" {
  let t = @tcl.Interpreter::new()
  assert_eq(
    t.eval("set a old;scan {12 34} {%d%d} a a;set a", budget=100000),
    "34",
  )
  assert_eq(t.output_text(), "")
}

///|
test "Tcl conversion conversion-state-4855" {
  let t = @tcl.Interpreter::new()
  assert_eq(
    t.eval(
      "set a old;array set b {k kept};catch {scan {12 34} {%d%d} a b};list $a [array get b]",
      budget=100000,
    ),
    "12 {k kept}",
  )
  assert_eq(t.output_text(), "")
}

///|
test "Tcl conversion conversion-state-4856" {
  let t = @tcl.Interpreter::new()
  assert_eq(
    t.eval(
      "set a old;proc parse {} {upvar #0 a out;scan 123 %d out};list [parse] $a",
      budget=100000,
    ),
    "1 123",
  )
  assert_eq(t.output_text(), "")
}

///|
test "Tcl conversion conversion-state-4857" {
  let t = @tcl.Interpreter::new()
  assert_eq(
    t.eval(
      "array set a {};scan {12 34} {%d%d} a(中) a(x);list $a(中) $a(x)",
      budget=100000,
    ),
    "12 34",
  )
  assert_eq(t.output_text(), "")
}

///|
test "Tcl conversion conversion-state-4858" {
  let t = @tcl.Interpreter::new()
  assert_eq(
    t.eval("scan {12 34} {%2$d %1$d} a b;list $a $b", budget=100000),
    "34 12",
  )
