  )
  check_switch_case(
    "catch {switch -matchvar m x} r o;list $r [dict get $o -code] [expr {[dict exists $o -errorcode] ? [dict get $o -errorcode] : {}}]",
    "{missing variable name argument to -matchvar option} 1 {TCL OPERATION SWITCH NOVAR}",
    "", false, "option-boundary-2182",
  )
  check_switch_case(
    "catch {switch -indexvar i x} r o;list $r [dict get $o -code] [expr {[dict exists $o -errorcode] ? [dict get $o -errorcode] : {}}]",
    "{missing variable name argument to -indexvar option} 1 {TCL OPERATION SWITCH NOVAR}",
    "", false, "option-boundary-2183",
  )
  check_switch_case(
    "catch {switch -exact x {}} r o;list $r [dict get $o -code] [expr {[dict exists $o -errorcode] ? [dict get $o -errorcode] : {}}]",
    "{wrong # args: should be \"switch ?-option ...? string {?pattern body ...? ?default body?}\"} 1 {TCL WRONGARGS}",
    "", false, "option-boundary-2184",
  )
  check_switch_case(
    "catch {switch -exact -- x} r o;list $r [dict get $o -code] [expr {[dict exists $o -errorcode] ? [dict get $o -errorcode] : {}}]",
    "{extra switch pattern with no body} 1 {TCL OPERATION SWITCH BADARM}", "", false,
    "option-boundary-2185",
  )
  check_switch_case(
    "catch {switch -regexp -matchvar m -- x} r o;list $r [dict get $o -code] [expr {[dict exists $o -errorcode] ? [dict get $o -errorcode] : {}}]",
    "{extra switch pattern with no body} 1 {TCL OPERATION SWITCH BADARM}", "", false,
    "option-boundary-2186",
  )
  check_switch_case(
    "catch {switch -nocase -nocase x x {expr 1}} r o;list $r [dict get $o -code] [expr {[dict exists $o -errorcode] ? [dict get $o -errorcode] : {}}]",
    "1 0 {}", "", false, "option-boundary-2187",
  )
  check_switch_case(
    "catch {switch -g -r x x {}} r o;list $r [dict get $o -code] [expr {[dict exists $o -errorcode] ? [dict get $o -errorcode] : {}}]",
    "{bad option \"-r\": -glob option already found} 1 {TCL OPERATION SWITCH DOUBLEOPT}",
    "", false, "option-boundary-2188",
  )
  check_switch_case(
    "catch {switch -i q x x {}} r o;list $r [dict get $o -code] [expr {[dict exists $o -errorcode] ? [dict get $o -errorcode] : {}}]",
    "{-indexvar option requires -regexp option} 1 {TCL OPERATION SWITCH MODERESTRICTION}",
    "", false, "option-boundary-2189",
  )
  check_switch_case(
    "catch {switch -regexp x \"(\" {}} r o;list $r [dict get $o -errorcode]", "{couldn't compile regular expression pattern: parentheses () not balanced} {REGEXP REG_EPAREN {parentheses () not balanced}}",
    "", false, "regexp-diagnostics-2190",
  )
  check_switch_case(
    "catch {switch -regexp x \"\\[\" {}} r o;list $r [dict get $o -errorcode]", "{couldn't compile regular expression pattern: brackets [] not balanced} {REGEXP REG_EBRACK {brackets [] not balanced}}",
    "", false, "regexp-diagnostics-2191",
  )
  check_switch_case(
    "catch {switch -regexp x \"\\[z-a\\]\" {}} r o;list $r [dict get $o -errorcode]",
    "{couldn't compile regular expression pattern: invalid character range} {REGEXP REG_ERANGE {invalid character range}}",
    "", false, "regexp-diagnostics-2192",
  )
  check_switch_case(
    "catch {switch -regexp x \"\\[\\[:word:\\]\\]\" {}} r o;list $r [dict get $o -errorcode]",
    "{couldn't compile regular expression pattern: invalid character class} {REGEXP REG_ECTYPE {invalid character class}}",
    "", false, "regexp-diagnostics-2193",
  )
  check_switch_case(
    "catch {switch -regexp x \"\\[\\[.ch.\\]\\]\" {}} r o;list $r [dict get $o -errorcode]",
    "{couldn't compile regular expression pattern: invalid collating element} {REGEXP REG_ECOLLATE {invalid collating element}}",
    "", false, "regexp-diagnostics-2194",
  )
  check_switch_case(
    "catch {switch -regexp x \"\\\\\" {}} r o;list $r [dict get $o -errorcode]",
    "{couldn't compile regular expression pattern: invalid escape \\ sequence} {REGEXP REG_EESCAPE {invalid escape \\ sequence}}",
    "", false, "regexp-diagnostics-2195",
  )
  check_switch_case(
    "catch {switch -regexp x \"\\\\q\" {}} r o;list $r [dict get $o -errorcode]",
    "{couldn't compile regular expression pattern: invalid escape \\ sequence} {REGEXP REG_EESCAPE {invalid escape \\ sequence}}",
    "", false, "regexp-diagnostics-2196",
  )
  check_switch_case(
    "catch {switch -regexp x \"\\\\1\" {}} r o;list $r [dict get $o -errorcode]",
    "{couldn't compile regular expression pattern: invalid backreference number} {REGEXP REG_ESUBREG {invalid backreference number}}",
    "", false, "regexp-diagnostics-2197",
  )
  check_switch_case(
