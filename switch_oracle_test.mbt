  check_switch_case(
    "catch {switch -regexp x \"a{256}\" {}} r o;list $r [dict get $o -errorcode]",
    "{couldn't compile regular expression pattern: invalid repetition count(s)} {REGEXP REG_BADBR {invalid repetition count(s)}}",
    "", false, "regexp-diagnostics-2199",
