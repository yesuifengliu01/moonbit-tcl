// Original programs, expected results evaluated by Tcl 8.6.15. Do not hand-edit.

///|
fn check_switch_case(
  source : String,
  expected : String,
  output : String,
  rejected : Bool,
  label : String,
) -> Unit raise {
  let t = @tcl.Interpreter::new()
  if rejected {
    assert_true(
      try {
        ignore(t.eval(source, budget=100000))
        false
      } catch {
        _ => true
      },
      msg=label[:],
    )
  } else {
    assert_eq(t.eval(source, budget=100000), expected, msg=label)
    assert_eq(t.output_text(), output, msg=label)
  }
}

///|
test "Tcl switch cases 1 through 40" {
  check_switch_case(
    "switch -- \"\" \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"",
    "fallback", "", false, "branch-order-0",
  )
  check_switch_case(
    "switch -- \"\" [list \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"]",
    "fallback", "", false, "branch-order-1",
  )
  check_switch_case(
    "switch -- \"a\" \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"",
    "first", "", false, "branch-order-2",
  )
  check_switch_case(
    "switch -- \"a\" [list \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"]",
    "first", "", false, "branch-order-3",
  )
  check_switch_case(
    "switch -- \"A\" \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"",
    "fallback", "", false, "branch-order-4",
  )
  check_switch_case(
    "switch -- \"A\" [list \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"]",
    "fallback", "", false, "branch-order-5",
  )
  check_switch_case(
    "switch -- \"abc\" \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"",
    "fallback", "", false, "branch-order-6",
  )
  check_switch_case(
    "switch -- \"abc\" [list \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"]",
    "fallback", "", false, "branch-order-7",
  )
  check_switch_case(
    "switch -- \"a*b\" \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"",
    "fallback", "", false, "branch-order-8",
  )
  check_switch_case(
    "switch -- \"a*b\" [list \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"]",
    "fallback", "", false, "branch-order-9",
  )
  check_switch_case(
    "switch -- \"default\" \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"",
    "fallback", "", false, "branch-order-10",
  )
  check_switch_case(
    "switch -- \"default\" [list \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"]",
    "fallback", "", false, "branch-order-11",
  )
  check_switch_case(
    "switch -- \"DEFAULT\" \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"",
    "fallback", "", false, "branch-order-12",
  )
  check_switch_case(
    "switch -- \"DEFAULT\" [list \"a\" \"list first\" \"a*\" \"list star\" \"default\" \"list fallback\"]",
