    "matched {{}} {{-1 -1}}", "", false, "seeded-composition-2156",
  )
  check_switch_case(
    "set m OLD;set ix OLD;set r [switch -regexp  -matchvar m -indexvar ix -- \"acbc\" \"\\[ab\\]*\\[^a\\]*\" {list matched} default {list default}];list $r $m $ix",
    "matched acbc {{0 3}}", "", false, "seeded-composition-2157",
