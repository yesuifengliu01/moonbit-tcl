    "matched {aa a} {{0 1} {1 1}}", "", false, "seeded-composition-2154",
  )
  check_switch_case(
    "set m OLD;set ix OLD;set r [switch -regexp  -matchvar m -indexvar ix -- \"c\" \"\\[ab\\]{1,2}\" {list matched} default {list default}];list $r $m $ix",
    "default {} {}", "", false, "seeded-composition-2155",
