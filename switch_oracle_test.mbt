    "matched cc {{0 1}}", "", false, "seeded-composition-1984",
  )
  check_switch_case(
    "set m OLD;set ix OLD;set r [switch -regexp  -matchvar m -indexvar ix -- \"accaab\" \"a\" {list matched} default {list default}];list $r $m $ix",
