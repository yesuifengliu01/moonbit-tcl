  check_switch_case(
    "set m OLD;set ix OLD;set r [switch -regexp  -matchvar m -indexvar ix -- \"a\" \"a{0,0}?\" {list matched} default {list default}];list $r $m $ix",
    "matched {{}} {{-1 -1}}", "", false, "preference-1969",
  )
  check_switch_case(
    "set m OLD;set ix OLD;set r [switch -regexp  -matchvar m -indexvar ix -- \"x\" \"(){2}\" {list matched} default {list default}];list $r $m $ix",
    "matched {{} {}} {{-1 -1} {-1 -1}}", "", false, "preference-1970",
