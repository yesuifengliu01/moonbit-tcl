    "set m OLD;set ix OLD;set r [switch -regexp  -matchvar m -indexvar ix -- \"acb\" \"b{1,2}b??b\" {list matched} default {list default}];list $r $m $ix",
    "default {} {}", "", false, "seeded-composition-2149",
