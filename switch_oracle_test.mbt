  )
  check_switch_case(
    "set m OLD;set ix OLD;set r [switch -regexp  -matchvar m -indexvar ix -- \"\" \"\\[ab\\]*b{1,2}(ab|a)\" {list matched} default {list default}];list $r $m $ix",
