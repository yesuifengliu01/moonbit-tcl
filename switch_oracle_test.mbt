  check_switch_case(
    "set m OLD;set ix OLD;set r [switch -regexp  -matchvar m -indexvar ix -- \"bcb\" \"\\[ab\\]{1,2}a{1,2}\" {list matched} default {list default}];list $r $m $ix",
