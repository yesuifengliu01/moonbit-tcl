///|
test "Tcl switch cases 1961 through 2000" {
  check_switch_case(
    "set m OLD;set ix OLD;set r [switch -regexp  -matchvar m -indexvar ix -- \"aa\" \"a(?i)b\" {list matched} default {list default}];list $r $m $ix",
    "couldn't compile regular expression pattern: quantifier operand invalid", "",
    true, "invalid-regexp-1960",
  )
  check_switch_case(
    "set m OLD;set ix OLD;set r [switch -regexp  -matchvar m -indexvar ix -- \"aa\" \"(?i:a)\" {list matched} default {list default}];list $r $m $ix",
    "couldn't compile regular expression pattern: invalid embedded option", "", true,
    "invalid-regexp-1961",
  )
  check_switch_case(
    "set m OLD;set ix OLD;set r [switch -regexp  -matchvar m -indexvar ix -- \"aa\" \"***x\" {list matched} default {list default}];list $r $m $ix",
    "couldn't compile regular expression pattern: quantifier operand invalid", "",
    true, "invalid-regexp-1962",
  )
  check_switch_case(
    "set m OLD;set ix OLD;set r [switch -regexp  -matchvar m -indexvar ix -- \"aa\" \"(?b)\\\\1\" {list matched} default {list default}];list $r $m $ix",
