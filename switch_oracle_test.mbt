    "set r {};foreach x {0 1 2 3} {switch $x 1 continue 3 break default {lappend r $x}};set r",
    "0 2", "", false, "control-and-values-190",
  )
  check_switch_case(
    "set r {};for {set i 0} {$i<4} {incr i} {switch $i 1 continue 3 break default {lappend r $i}};set r",
    "0 2", "", false, "control-and-values-191",
  )
  check_switch_case(
    "namespace eval n {variable v 7;proc f x {variable v;switch $x a {incr v} default {set v}}};list [n::f a] [n::f b]",
    "8 8", "", false, "control-and-values-192",
  )
  check_switch_case(
    "rename switch choose;namespace eval n {namespace path ::;choose x x {expr 3}}",
    "3", "", false, "control-and-values-193",
  )
  check_switch_case(
    "set m old;set i old;switch -regexp -matchvar m -indexvar i x a {};list $m $i",
    "old old", "", false, "control-and-values-194",
  )
  check_switch_case(
    "set m old;set i old;switch -regexp -matchvar m -indexvar i x a {} default {};list $m $i",
    "{} {}", "", false, "control-and-values-195",
  )
  check_switch_case(
    "switch -regexp -matchvar m -indexvar m abc {(a)(b*)} {set m}", "ab a b", "",
    false, "control-and-values-196",
  )
  check_switch_case(
    "switch -regexp -matchvar m abc {(a)} - {(?invalid} {set m}", "a a", "", false,
    "control-and-values-197",
  )
  check_switch_case(
    "switch -regexp x x {list yes} {(?invalid} {error ignored}", "yes", "", false,
    "control-and-values-198",
  )
  check_switch_case(
    "switch -regexp -matchvar m -matchvar n abc {(a)} {list [info exists m] $n}",
    "0 {a a}", "", false, "control-and-values-199",
  )
}

///|
test "Tcl switch cases 201 through 240" {
  check_switch_case(
    "array set a {};switch -regexp -matchvar a(m) -indexvar a(i) abc {(a)(b*)} {list $a(m) $a(i)}",
    "{ab a b} {{0 1} {0 0} {1 1}}", "", false, "control-and-values-200",
  )
  check_switch_case(
    "set a 0;set m old;catch {switch -regexp -indexvar a(i) -matchvar m abc a {error no}} r;list $a $m",
    "0 old", "", false, "control-and-values-201",
  )
  check_switch_case(
    "set a 0;set ix old;catch {switch -regexp -indexvar ix -matchvar a(m) abc a {error no}} r;list $a $ix",
    "0 {{0 0}}", "", false, "control-and-values-202",
  )
  check_switch_case(
    "scan 18446744073709551616 %f v;format %.17g [switch a a [list list $v]]", "1.844674407370955e+19",
    "", false, "control-and-values-203",
  )
  check_switch_case(
    "scan 18446744073709551616 %f v;format %.17g [lindex [switch a [list a [list list $v]]] 0]",
    "1.8446744073709552e+19", "", false, "control-and-values-204",
  )
  check_switch_case(
    "set effect 0;catch {switch x x {incr effect;error bad}} r o;list $effect $r [string match {*\"x\" arm line 1*} [dict get $o -errorinfo]]",
    "1 bad 1", "", false, "control-and-values-205",
  )
  check_switch_case(
    "catch {switch a a - b {error bad}} r o;list $r [string match {*\"a\" arm line 1*} [dict get $o -errorinfo]]",
    "bad 1", "", false, "control-and-values-206",
  )
  check_switch_case(
    "catch {switch x x {return -code 7 -note custom yes}} r o;list $r [dict get $o -code] [dict get $o -level] [dict get $o -note]",
    "yes 7 1 custom", "", false, "control-and-values-207",
  )
  check_switch_case(
    "switch", "wrong # args: should be \"switch ?-option ...? string ?pattern body ...? ?default body?\"",
    "", true, "syntax-rejection-208",
  )
  check_switch_case(
    "catch {switch} r o;list $r [dict get $o -errorcode]", "{wrong # args: should be \"switch ?-option ...? string ?pattern body ...? ?default body?\"} {TCL WRONGARGS}",
    "", false, "error-code-209",
  )
  check_switch_case(
    "switch x", "wrong # args: should be \"switch ?-option ...? string ?pattern body ...? ?default body?\"",
    "", true, "syntax-rejection-210",
  )
  check_switch_case(
    "catch {switch x} r o;list $r [dict get $o -errorcode]", "{wrong # args: should be \"switch ?-option ...? string ?pattern body ...? ?default body?\"} {TCL WRONGARGS}",
    "", false, "error-code-211",
  )
  check_switch_case(
    "switch x {}", "wrong # args: should be \"switch ?-option ...? string {?pattern body ...? ?default body?}\"",
    "", true, "syntax-rejection-212",
  )
  check_switch_case(
    "catch {switch x {}} r o;list $r [dict get $o -errorcode]", "{wrong # args: should be \"switch ?-option ...? string {?pattern body ...? ?default body?}\"} {TCL WRONGARGS}",
    "", false, "error-code-213",
  )
  check_switch_case(
    "switch x {x}", "extra switch pattern with no body", "", true, "syntax-rejection-214",
  )
  check_switch_case(
    "catch {switch x {x}} r o;list $r [dict get $o -errorcode]", "{extra switch pattern with no body} {TCL OPERATION SWITCH BADARM}",
    "", false, "error-code-215",
  )
  check_switch_case(
    "switch x x {} z", "extra switch pattern with no body", "", true, "syntax-rejection-216",
  )
  check_switch_case(
    "catch {switch x x {} z} r o;list $r [dict get $o -errorcode]", "{extra switch pattern with no body} {TCL OPERATION SWITCH BADARM}",
    "", false, "error-code-217",
  )
  check_switch_case(
    "switch x x {} z -", "no body specified for pattern \"z\"", "", true, "syntax-rejection-218",
  )
  check_switch_case(
    "catch {switch x x {} z -} r o;list $r [dict get $o -errorcode]", "{no body specified for pattern \"z\"} {TCL OPERATION SWITCH BADARM FALLTHROUGH}",
    "", false, "error-code-219",
  )
  check_switch_case(
    "switch x a {} z -", "no body specified for pattern \"z\"", "", true, "syntax-rejection-220",
  )
  check_switch_case(
    "catch {switch x a {} z -} r o;list $r [dict get $o -errorcode]", "{no body specified for pattern \"z\"} {TCL OPERATION SWITCH BADARM FALLTHROUGH}",
    "", false, "error-code-221",
  )
  check_switch_case(
    "switch -exact -glob x x {}", "bad option \"-glob\": -exact option already found",
    "", true, "syntax-rejection-222",
  )
  check_switch_case(
    "catch {switch -exact -glob x x {}} r o;list $r [dict get $o -errorcode]", "{bad option \"-glob\": -exact option already found} {TCL OPERATION SWITCH DOUBLEOPT}",
    "", false, "error-code-223",
  )
  check_switch_case(
    "switch -exact -exact x x {}", "bad option \"-exact\": -exact option already found",
    "", true, "syntax-rejection-224",
  )
  check_switch_case(
    "catch {switch -exact -exact x x {}} r o;list $r [dict get $o -errorcode]", "{bad option \"-exact\": -exact option already found} {TCL OPERATION SWITCH DOUBLEOPT}",
    "", false, "error-code-225",
  )
  check_switch_case(
    "switch -matchvar m x x {}", "-matchvar option requires -regexp option", "",
    true, "syntax-rejection-226",
  )
  check_switch_case(
    "catch {switch -matchvar m x x {}} r o;list $r [dict get $o -errorcode]", "{-matchvar option requires -regexp option} {TCL OPERATION SWITCH MODERESTRICTION}",
    "", false, "error-code-227",
  )
  check_switch_case(
    "switch -indexvar i x x {}", "-indexvar option requires -regexp option", "",
    true, "syntax-rejection-228",
  )
  check_switch_case(
    "catch {switch -indexvar i x x {}} r o;list $r [dict get $o -errorcode]", "{-indexvar option requires -regexp option} {TCL OPERATION SWITCH MODERESTRICTION}",
    "", false, "error-code-229",
  )
  check_switch_case(
    "switch -matchvar m -indexvar i x x {}", "-indexvar option requires -regexp option",
    "", true, "syntax-rejection-230",
  )
  check_switch_case(
    "catch {switch -matchvar m -indexvar i x x {}} r o;list $r [dict get $o -errorcode]",
    "{-indexvar option requires -regexp option} {TCL OPERATION SWITCH MODERESTRICTION}",
    "", false, "error-code-231",
  )
  check_switch_case(
    "switch -bad x x {}", "bad option \"-bad\": must be -exact, -glob, -indexvar, -matchvar, -nocase, -regexp, or --",
    "", true, "syntax-rejection-232",
  )
  check_switch_case(
    "switch - x x {}", "ambiguous option \"-\": must be -exact, -glob, -indexvar, -matchvar, -nocase, -regexp, or --",
    "", true, "syntax-rejection-233",
  )
  check_switch_case(
    "switch -regexp -indexvar", "extra switch pattern with no body", "", true, "syntax-rejection-234",
  )
  check_switch_case(
    "catch {switch -regexp -indexvar} r o;list $r [dict get $o -errorcode]", "{extra switch pattern with no body} {TCL OPERATION SWITCH BADARM}",
    "", false, "error-code-235",
  )
  check_switch_case(
    "switch -regexp -matchvar m", "extra switch pattern with no body", "", true,
    "syntax-rejection-236",
  )
  check_switch_case(
    "catch {switch -regexp -matchvar m} r o;list $r [dict get $o -errorcode]", "{extra switch pattern with no body} {TCL OPERATION SWITCH BADARM}",
    "", false, "error-code-237",
  )
  check_switch_case(
